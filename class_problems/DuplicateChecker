public class DuplicateChecker {

    public static boolean containsDuplicate(int[] nums) {
        // Outer loop picks the first element to compare
        for (int i = 0; i < nums.length; i++) {
            // Inner loop checks every element AFTER the current 'i'
            for (int j = i + 1; j < nums.length; j++) {
                // If a match is found, return true immediately (early exit)
                if (nums[i] == nums[j]) {
                    return true;
                }
            }
        }
        // If the loops finish without finding any matches, return false
        return false;
    }

    public static void main(String[] args) {
        // Test Case 1
        int[] nums1 = {1, 2, 3, 1};
        System.out.println(containsDuplicate(nums1)); // Output: true

        // Test Case 2
        int[] nums2 = {1, 2, 3, 4};
        System.out.println(containsDuplicate(nums2)); // Output: false
    }
}