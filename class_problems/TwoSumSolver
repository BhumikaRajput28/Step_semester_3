import java.util.Arrays;

public class TwoSumSolver {

    public static int[] twoSum(int[] nums, int target) {
        // Outer loop picks the first element
        for (int i = 0; i < nums.length; i++) {
            // Inner loop picks the second element, starting just after i
            for (int j = i + 1; j < nums.length; j++) {
                // Check if they add up to the target
                if (nums[i] + nums[j] == target) {
                    return new int[]{i, j}; // Return the indices immediately
                }
            }
        }
        // Return an empty array if no pair is found (though the problem guarantees one valid pair)
        return new int[]{}; 
    }

    public static void main(String[] args) {
        // Test Case 1
        int[] nums1 = {2, 7, 11, 15};
        int target1 = 9;
        System.out.println(Arrays.toString(twoSum(nums1, target1))); // Output: [0, 1]

        // Test Case 2
        int[] nums2 = {3, 2, 4};
        int target2 = 6;
        System.out.println(Arrays.toString(twoSum(nums2, target2))); // Output: [1, 2]
    }
}