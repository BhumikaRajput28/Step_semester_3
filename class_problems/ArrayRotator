import java.util.Arrays;

public class ArrayRotator {

    public static int[] rotateArray(int[] nums, int k) {
        int n = nums.length;
        
        // Handle empty array edge case to prevent division by zero
        if (n == 0) return nums; 
        
        // 1. Reduce k to prevent unnecessary full rotations
        k = k % n;
        
        // 2. Create a new array of the same size
        int[] newArray = new int[n];
        
        // 3. Calculate new positions and place the elements
        for (int i = 0; i < n; i++) {
            int newPosition = (i + k) % n;
            newArray[newPosition] = nums[i];
        }
        
        // 4. Return the new array
        return newArray;
    }

    public static void main(String[] args) {
        // Test Case 1
        int[] nums1 = {1, 2, 3, 4, 5, 6, 7};
        int k1 = 3;
        System.out.println(Arrays.toString(rotateArray(nums1, k1))); 
        // Output: [5, 6, 7, 1, 2, 3, 4]

        // Test Case 2
        int[] nums2 = {1, 2};
        int k2 = 3;
        System.out.println(Arrays.toString(rotateArray(nums2, k2))); 
        // Output: [2, 1]
    }
}