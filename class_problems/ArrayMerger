import java.util.Arrays;

public class ArrayMerger {

    public static int[] mergeSortedArrays(int[] arr1, int[] arr2) {
        // Create a new array large enough to hold all elements from both input arrays
        int[] result = new int[arr1.length + arr2.length];
        
        // Pointers for arr1 (i), arr2 (j), and the result array (k)
        int i = 0, j = 0, k = 0;
        
        // Compare elements and copy the smaller one into the result array
        while (i < arr1.length && j < arr2.length) {
            if (arr1[i] <= arr2[j]) {
                result[k] = arr1[i];
                i++;
            } else {
                result[k] = arr2[j];
                j++;
            }
            k++;
        }
        
        // If arr1 still has elements left, copy them over
        while (i < arr1.length) {
            result[k] = arr1[i];
            i++;
            k++;
        }
        
        // If arr2 still has elements left, copy them over
        while (j < arr2.length) {
            result[k] = arr2[j];
            j++;
            k++;
        }
        
        return result;
    }

    public static void main(String[] args) {
        // Test Case 1
        int[] arr1 = {1, 3, 5};
        int[] arr2 = {2, 4, 6};
        System.out.println(Arrays.toString(mergeSortedArrays(arr1, arr2))); 
        // Output: [1, 2, 3, 4, 5, 6]

        // Test Case 2
        int[] arr3 = {};
        int[] arr4 = {1, 2, 3};
        System.out.println(Arrays.toString(mergeSortedArrays(arr3, arr4))); 
        // Output: [1, 2, 3]
    }
}