public class FindMinimum {
    public static int findMin(int[] nums) {
        int left = 0;
        int right = nums.length - 1;
        
        while (left < right) {
            int mid = left + (right - left) / 2;
            
            // If mid is greater than the rightmost element, the drop is on the right
            if (nums[mid] > nums[right]) {
                left = mid + 1;
            } 
            // Otherwise, the right half is sorted, so the minimum is at mid or left of mid
            else {
                right = mid;
            }
        }
        
        // When the pointers meet, we've pinpointed the minimum
        return nums[left];
    }
}