import java.util.HashMap;

public class SubarraySum {
    public static int subarraySum(int[] nums, int k) {
        // Map to store <Prefix Sum, Frequency>
        HashMap<Integer, Integer> prefixCounts = new HashMap<>();
        
        // Base case: a prefix sum of 0 happens exactly once initially
        prefixCounts.put(0, 1); 
        
        int currentSum = 0;
        int count = 0;
        
        for (int num : nums) {
            currentSum += num;
            
            // Check if removing a previous prefix gets us exactly 'k'
            if (prefixCounts.containsKey(currentSum - k)) {
                count += prefixCounts.get(currentSum - k);
            }
            
            // Add the current sum to the map for future checks
            prefixCounts.put(currentSum, prefixCounts.getOrDefault(currentSum, 0) + 1);
        }
        
        return count;
    }
}