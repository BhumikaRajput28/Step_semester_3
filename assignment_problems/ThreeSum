import java.util.Arrays;
import java.util.ArrayList;
import java.util.List;

public class ThreeSum {
    public static int[][] threeSum(int[] nums) {
        List<int[]> resultList = new ArrayList<>();
        Arrays.sort(nums); // Sort first for the two-pointer approach
        int n = nums.length;
        
        for (int i = 0; i < n - 2; i++) {
            // Skip duplicate values for the first element
            if (i > 0 && nums[i] == nums[i - 1]) continue;
            
            // Two pointers moving inward
            int j = i + 1;
            int k = n - 1;
            
            while (j < k) {
                int sum = nums[i] + nums[j] + nums[k];
                
                if (sum == 0) {
                    resultList.add(new int[]{nums[i], nums[j], nums[k]});
                    
                    // Skip duplicate values for the second and third elements
                    while (j < k && nums[j] == nums[j + 1]) j++;
                    while (j < k && nums[k] == nums[k - 1]) k--;
                    
                    j++;
                    k--;
                } else if (sum < 0) {
                    j++;
                } else {
                    k--;
                }
            }
        }
        
        // Convert the List back to a 2D array to match the signature
        return resultList.toArray(new int[0][]);
    }
}