public class LibraryValidator {

    public static String normalizeCode(String raw) {
        // 1. trim() the spaces
        String trimmed = raw.trim();
        
        // Safety check to avoid index out of bounds on very short invalid strings
        if (trimmed.length() < 3) {
            return trimmed; 
        }
        
        // 2. uppercase only the first 3 characters using substring() + concatenation
        String firstThree = trimmed.substring(0, 3).toUpperCase();
        String rest = trimmed.substring(3);
        
        return firstThree + rest;
    }

    public static String validateAndFormat(String code) {
        // Validate exactly 13 characters
        if (code.length() != 13) {
            return "Invalid: wrong length";
        }
        
        // Validate first 3 characters are letters
        for (int i = 0; i < 3; i++) {
            if (!Character.isLetter(code.charAt(i))) {
                return "Invalid: publisher code must be 3 letters";
            }
        }
        
        // Validate remaining 10 are digits
        for (int i = 3; i < 13; i++) {
            if (!Character.isDigit(code.charAt(i))) {
                return "Invalid: non-digit body";
            }
        }
        
        // Extract components for formatting
        String pubCode = code.substring(0, 3);
        String year = code.substring(3, 7);
        String catalog = code.substring(7, 13);
        
        // Build formatted display line with StringBuilder
        StringBuilder sb = new StringBuilder();
        sb.append("[").append(pubCode).append("] YEAR: ")
          .append(year).append(" | CATALOG: ").append(catalog);
          
        return sb.toString();
    }

    public static void main(String[] args) {
        // Test Case 1
        String raw1 = " pen2026004251 ";
        String normalized1 = normalizeCode(raw1);
        System.out.println(validateAndFormat(normalized1));

        // Test Case 2
        String raw2 = "12N2026004251";
        String normalized2 = normalizeCode(raw2);
        System.out.println(validateAndFormat(normalized2));
    }
}